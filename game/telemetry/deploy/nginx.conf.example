# Replace stats.example.invalid and certificate paths before deployment.
# Application binds 127.0.0.1:8767. Do not expose its socket publicly.
server {
    listen 443 ssl;
    server_name stats.example.invalid;
    ssl_certificate /etc/deidei-stats/tls/fullchain.pem;
    ssl_certificate_key /etc/deidei-stats/tls/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    # nginx error logs can include client IPs/headers; disable persistent request error logs too.
    error_log /dev/null crit;
    client_max_body_size 32k;
    location / {
        proxy_pass http://127.0.0.1:8767;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Cookie "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
        proxy_send_timeout 10s;
        proxy_hide_header Set-Cookie;
    }
}
