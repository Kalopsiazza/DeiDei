{
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.3.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "@electron/packager": "20.3.0"
  },
  "name": "deidei-r02-desktop",
  "productName": "DeiDei R02",
  "version": "0.1.0",
  "private": true,
  "description": "R02-T04-a local single-player source build",
  "author": "DeiDei contributors",
  "main": "main.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node build.cjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test test.cjs test-live.cjs test-navigation.cjs test-packaging.cjs",
    "smoke": "node smoke-live.cjs",
    "test:online": "npm run build && node --test tests-online/test-*.cjs",
    "smoke:online": "npm run build && node tests-online/smoke.cjs",
    "package": "python ../packaging/build.py"
  }
}
